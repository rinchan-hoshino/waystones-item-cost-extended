{
  "schemaVersion": 1,
  "id": "waystones_item_cost_extended",
  "version": "${version}",
  "name": "Waystones Item Cost Extended",
  "description": "Extend Waystones with reversible multi-denomination payments, nested container deductions, combined item costs, payment tooltips, and optional Lightman's Currency support.",
  "icon": "icon.png",
  "authors": ["RinChan"],
  "contact": {
    "homepage": "https://modrinth.com/mod/waystones-item-cost-extended",
    "sources": "https://github.com/rinchan-hoshino/waystones-item-cost-extended",
    "issues": "https://github.com/rinchan-hoshino/waystones-item-cost-extended/issues"
  },
  "license": "GPL-3.0-or-later",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.rinchan.waystonesitemcost.WaystonesItemCostFabricMod"
    ],
    "modmenu": [
      "dev.rinchan.waystonesitemcost.client.ModMenuIntegration"
    ]
  },
  "mixins": [
    "waystones_item_cost_extended.mixins.json",
    "waystones_item_cost_extended.client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": ${minecraft_versions_json},
    "java": ">=${java_version}",
    "waystones": ">=${waystones_version}",
    "balm-fabric": ">=${balm_version}"${shogi_dependency_json}
  }
}
